    },
    {
      "name": "Goal choice",
      "kind": "custom",
      "refersTo": "goal-choice",
      "description": "Full-width choice with a check and a short explanation.",
      "html": "<button class=\"ds-goal\" type=\"button\" aria-pressed=\"true\"><span class=\"ds-check\"><svg viewBox=\"0 0 24 24\" width=\"12\" height=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m9 18-6-6 6 6L21 6\"/></svg></span><span><span class=\"ds-title\">Plan a new loan</span><span class=\"ds-detail\">Find a monthly payment or a loan amount that fits your budget.</span></span></button>",
      "css": ".ds-goal{font-family:var(--font-lexend, Lexend),Arial,Helvetica,sans-serif;display:flex;width:100%;align-items:flex-start;gap:1rem;border:1px solid var(--foreground,oklch(.145 0 0));border-radius:calc(var(--radius,.625rem) + 4px);padding:1.25rem;text-align:left;color:var(--foreground,oklch(.145 0 0));background:color-mix(in oklab,var(--muted,oklch(.97 0 0)) 40%,transparent);cursor:pointer;transition:background-color 150ms}.ds-title{display:block;font-size:1rem;font-weight:500}.ds-detail{display:block;margin-top:.5rem;font-size:.875rem;line-height:1.5rem;color:var(--muted-foreground,oklch(.556 0 0))}.ds-check{display:flex;width:1.25rem;height:1.25rem;flex-shrink:0;align-items:center;justify-content:center;margin-top:.125rem;border-radius:9999px;background:var(--foreground,oklch(.145 0 0));color:var(--background,#fff)}.ds-goal:focus-visible{outline:2px solid var(--foreground,oklch(.145 0 0));outline-offset:2px}.ds-goal[aria-pressed=\"false\"]{background:transparent;border-color:var(--border,oklch(.922 0 0))}.ds-goal[aria-pressed=\"false\"]:hover{background:color-mix(in oklab,var(--muted,oklch(.97 0 0)) 30%,transparent)}"
    }
