      "css": ".ds-button{font-family:var(--font-lexend, Lexend),Arial,Helvetica,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;height:2.75rem;padding:.5rem 1rem;border-radius:calc(var(--radius,.625rem) - 2px);font-size:.875rem;font-weight:500;transition:all 150ms cubic-bezier(.4,0,.2,1);cursor:pointer;border:0;background:transparent;color:var(--foreground,oklch(.145 0 0))}.ds-button:hover{background:linear-gradient(to right,oklch(64.5% .246 16.439 / .1),oklch(62.3% .214 259.815 / .1))}.ds-button:focus-visible{outline:2px solid var(--foreground,oklch(.145 0 0));outline-offset:4px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,oklch(.708 0 0)) 50%,transparent)}.ds-button:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Guided field",
      "kind": "input",
      "refersTo": "guided-input",
      "description": "A label and local help stay above a tall number input.",
      "html": "<div class=\"ds-field\"><label for=\"ds-loan\">Amount to borrow</label><p id=\"ds-loan-help\">The amount you plan to borrow.</p><input id=\"ds-loan\" type=\"number\" value=\"3500000\" aria-describedby=\"ds-loan-help\"></div>",
      "css": ".ds-field{font-family:var(--font-lexend, Lexend),Arial,Helvetica,sans-serif;color:var(--foreground,oklch(.145 0 0));font-size:.875rem}.ds-field label{font-weight:500}.ds-field p{margin:.5rem 0;line-height:1.5rem;color:var(--muted-foreground,oklch(.556 0 0))}.ds-field input{font-family:var(--font-lexend, Lexend),Arial,Helvetica,sans-serif;width:100%;height:3rem;padding:.5rem .75rem;box-sizing:border-box;border:1px solid var(--input,oklch(.922 0 0));border-radius:calc(var(--radius,.625rem) - 2px);background:var(--background,#fff);color:inherit;font-size:1rem;font-variant-numeric:tabular-nums;transition:border-color 150ms;outline:none}.ds-field input:focus-visible{box-shadow:0 0 0 2px var(--ring,oklch(.708 0 0))}.ds-field input:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat bordered container used in Advanced.",
      "html": "<section class=\"ds-card\"><h3>Loan details</h3><p>Enter the figures from your loan offer.</p></section>",
      "css": ".ds-card{font-family:var(--font-lexend, Lexend),Arial,Helvetica,sans-serif;border:1px solid var(--border,oklch(.922 0 0));border-radius:var(--radius,.625rem);background:var(--card,#fff);color:var(--card-foreground,oklch(.145 0 0));padding:1rem}.ds-card h3{margin:0;font-size:1rem;line-height:1;font-weight:600}.ds-card p{margin:.375rem 0 0;font-size:.875rem;color:var(--muted-foreground,oklch(.556 0 0))}@media(min-width:40rem){.ds-card{padding:1.25rem}}"
    },
    {
      "name": "Progress",
      "kind": "nav",
      "description": "Step text and bars show position in the guided form.",
      "html": "<nav class=\"ds-progress\" aria-label=\"Estimate progress\"><p>Step 2 of 6 · New loan</p><ol><li class=\"ds-done\"></li><li class=\"ds-done\" aria-current=\"step\"></li><li></li><li></li><li></li><li></li></ol></nav>",
      "css": ".ds-progress{font-family:var(--font-lexend, Lexend),Arial,Helvetica,sans-serif;color:var(--foreground,oklch(.145 0 0));font-size:.875rem}.ds-progress p{margin:0 0 .75rem}.ds-progress ol{display:flex;gap:.375rem;margin:0;padding:0;list-style:none}.ds-progress li{flex:1;height:.25rem;border-radius:9999px;background:var(--muted,oklch(.97 0 0))}.ds-progress li.ds-done{background:var(--foreground,oklch(.145 0 0))}"
    },
    {
      "name": "Example label",
