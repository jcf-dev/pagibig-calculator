      "css": ".ds-button{font-family:var(--font-lexend, Lexend),Arial,Helvetica,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;height:2.75rem;padding:.5rem 1rem;border-radius:calc(var(--radius,.625rem) - 2px);font-size:.875rem;font-weight:500;transition:all 150ms cubic-bezier(.4,0,.2,1);cursor:pointer;border:1px solid var(--input,oklch(.922 0 0));background:var(--background,#fff);color:var(--foreground,oklch(.145 0 0));box-shadow:0 1px 2px rgb(0 0 0 / .05)}.ds-button:hover{border-color:oklch(64.5% .246 16.439 / .5);background:linear-gradient(to right,oklch(64.5% .246 16.439 / .1),oklch(62.3% .214 259.815 / .1))}.ds-button:focus-visible{outline:2px solid var(--foreground,oklch(.145 0 0));outline-offset:4px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,oklch(.708 0 0)) 50%,transparent)}.ds-button:disabled{pointer-events:none;opacity:.5}"
