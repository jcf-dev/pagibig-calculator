      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action and selected calculator mode.",
      "html": "<button class=\"ds-button\">Start my estimate</button>",
      "css": ".ds-button{font-family:var(--font-lexend, Lexend),Arial,Helvetica,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;height:2.75rem;padding:.5rem 1rem;border-radius:calc(var(--radius,.625rem) - 2px);font-size:.875rem;font-weight:500;transition:all 150ms cubic-bezier(.4,0,.2,1);cursor:pointer;border:0;background:linear-gradient(to right,oklch(51.4% .222 16.935),oklch(48.8% .243 264.376));color:#fff;box-shadow:0 1px 3px rgb(0 0 0 / .1),0 1px 2px -1px rgb(0 0 0 / .1)}.ds-button:hover{background:linear-gradient(to right,oklch(45.5% .188 13.697),oklch(42.4% .199 265.638))}.ds-button:focus-visible{outline:2px solid var(--foreground,oklch(.145 0 0));outline-offset:4px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,oklch(.708 0 0)) 50%,transparent)}.ds-button:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Outline button",
